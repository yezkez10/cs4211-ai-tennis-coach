{
  "name": "cs4211",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:docker": "docker compose --profile development --env-file .env.development up --remove-orphans --detach",
    "dev:webapp": "pnpm --filter webapp run dev",
    "dev:server": "pnpm --filter server run dev",
    "dev": "pnpm run --stream /^dev:.*/",
    "lint:webapp": "pnpm --filter webapp run lint",
    "lint:server": "pnpm --filter server run lint",
    "lint:common": "pnpm --filter common run lint",
    "lint": "pnpm run --stream /^lint:.*/",
    "lint-check:webapp": "pnpm --filter webapp run lint-check",
    "lint-check:server": "pnpm --filter server run lint-check",
    "lint-check:common": "pnpm --filter common run lint-check",
    "lint-check": "pnpm run --stream /^lint-check:.*/",
    "format": "prettier --write \"**/*.{html,json,md,sql,ts,tsx}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format-check": "prettier --check \"**/*.{html,json,md,sql,ts,tsx}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "cross-env": "^7.0.3",
    "eslint": "9.39.3",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.28.0",
    "common": "link:common",
    "dayjs": "^1.11.13",
    "zod": "^4.3.6"
  }
}
